# System 2 — positioning engine (FastAPI).
# Defaults match Tion-ping/system2-positioning-engine's local docker-compose:
#   System 2 API on :8000, Postgres on :5432, DB `dronedetection`,
#   read-only role `system3_reader` with password `system3reader`.
#
# Run System 2 locally:
#   git clone https://github.com/Tion-ping/system2-positioning-engine
#   cd system2-positioning-engine && docker-compose up
SYSTEM2_API_URL=http://localhost:8000
DATABASE_URL=postgresql://system3_reader:system3reader@localhost:5432/dronedetection

# How often the dashboard polls /api/positions (ms). Matches System 2's
# triangulation loop (500ms by default) so we don't poll faster than results
# can possibly change.
POSITIONS_POLL_MS=1500

# How many recent positions to return per /api/positions request.
POSITIONS_LIMIT=200

# System 4 — tracking engine.
# /api/tracks queries the DB directly (same pgPool as /api/positions), so no
# separate URL is required. Run the migration first:
#   psql $DATABASE_URL -f system4-tracking-engine/migrations/001_create_tracks.sql
# Then start System 4 locally:
#   cd system4-tracking-engine && pip install -r requirements.txt
#   uvicorn system4.main:app --reload --port 8001
